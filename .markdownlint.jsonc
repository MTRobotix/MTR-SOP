// Canonical SOP Markdown rules. See .claude/skills/mtr-sop-content/SKILL.md §5.
{
  "default": true,
  "MD003": { "style": "atx" },
  "MD004": { "style": "dash" },
  "MD007": { "indent": 2 },
  "MD013": false,
  "MD024": { "siblings_only": false },
  "MD025": false,
  "MD029": { "style": "ordered" },
  "MD033": { "allowed_elements": ["details", "summary", "kbd", "sub", "sup", "mark", "br"] },
  "MD040": true,
  "MD041": false,
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },
  "MD049": { "style": "underscore" },
  "MD050": { "style": "asterisk" }
}
