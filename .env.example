# Session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Postgres (Neon) connection string. Leave empty locally to use PGlite in .data/pglite.
DATABASE_URL=

# First admin, created by `npm run db:setup`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI answer bubble. AI_PROVIDER=anthropic|none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Content store. Leave GITHUB_TOKEN empty locally: saves write to ./content (admin) or ./.drafts (editor).
# Fine-grained token, this repo only, permissions: Contents RW, Pull requests RW.
GITHUB_TOKEN=
GITHUB_REPO=owner/MTR-HOME
GITHUB_BRANCH=main

# IANA time zone that decides which day is "today": the week the timesheet opens on and when a
# due date is overdue. Empty = UTC. Example: Asia/Ho_Chi_Minh
APP_TIME_ZONE=
